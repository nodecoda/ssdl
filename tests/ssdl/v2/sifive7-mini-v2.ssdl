# v2 twin of tests/ssdl/sifive7-mini.ssdl.  Must lower to the same records.
#
# Covers: every feature kind with typed fields, instruction sets, predicate
# expression / select / sti / tii forms, predicate prolog, both machine
# itineraries and a top-level itinerary, machine alias, and the whole
# entity/relation surface.

feature FeatureSSDL64Bit {
    bool IsRV64 = true;
    mattr = "ssdl-64bit";
    desc  = "Implements RV64";
}

feature StdExtXssdl {
    kind = extension;
    version = "2.1";
    bitmask = {
        group = 0;
        bit   = 8;
    }
    desc = "SSDL base extension";
}

feature StdExtZssdlcsr {
    kind = extension;
    version = "2.0";
    desc = "SSDL CSR instructions";
}

feature StdExtZssdlcnt {
    kind = extension;
    version = "2.0";
    implies = [StdExtZssdlcsr];
    bitmask = {
        group = 1;
        bit   = 15;
    }
    desc = "SSDL counters";
}

feature StdExtZssdlexp {
    kind = extension;
    version = "0.1";
    experimental = true;
    bitmask = {
        group = 1;
        bit   = 13;
    }
    desc = "SSDL experimental extension";
}

feature TuneSSDLPostRA {
    kind = tune;
    bool UsePostRAScheduler = true;
    positive_directive = "use-ssdl-postra-scheduler";
    negative_directive = "no-use-ssdl-postra-scheduler";
    desc = "Schedule again after register allocation";
}

# ============ compile-time sets (tests/ssdl/attrs.json) ============
set instructions ZeroRegs = reg(is_zero);
set instructions ALUInsts = inst(category == "alu");
set instructions Logical  = [AND, XOR, ...ALUInsts];

# ============ predicates ============
predicate IsZeroReg(i: INT) = reg_is(i, ZeroRegs);
predicate IsALU = opcode(ALUInsts);
predicate IsALUAndZero(i: INT) = all_of(opcode(Logical), IsZeroReg(i));
predicate HasXssdl = feature(StdExtXssdl);

predicate SelNoXssdl : select {
    when   = host [{ !Subtarget->hasStdExtXssdl() }];
    during = none_of([StdExtXssdl]);
    desc   = "SSDL base extension is absent";
    recompute_per_function = true;
}

predicate prolog = host [{ 
    [[maybe_unused]] const RISCVInstrInfo *TII =
        static_cast<const RISCVInstrInfo*>(SchedModel->getInstrInfo());
}];

# ============ STI ============
predicate isZeroIdiom : sti {
    default     = false;
    opcode_mask = true;
    impl SSDLZeroIdiom : ssdl-sifive-7 {
        dep_breaking_class XorX0X0(
            [XOR],
            all_of(opcode([XOR]), IsZeroReg(1), IsZeroReg(2)),
            [1, 2]
        );
    }
}

predicate isDependencyBreaking : sti {
    default     = false;
    opcode_mask = true;
    delegates   = [isZeroIdiom];
    impl SSDLDepBreaking : ssdl-sifive-7 {
        dep_breaking_class XorSelf(
            [XOR],
            all_of(opcode([XOR]), same_reg(1, 2)),
            [1, 2]
        );
    }
}

predicate isXorZeroIdiom : tii {
    switch opcode {
        case [XOR]: return all_of(opcode([XOR]), IsZeroReg(1));
        default:    return false;
    }
}

machine both ssdl-generic-rv64 {
    features      = [FeatureSSDL64Bit, StdExtXssdl];
    default_march = "rv64i2p1";
}

machine both ssdl-sifive-7 {
    features             = [FeatureSSDL64Bit, StdExtXssdl, StdExtZssdlcnt];
    tune_features        = [TuneSSDLPostRA];
    issue_width          = 2;
    micro_op_buffer_size = 0;
    load_latency         = 3;
    mispredict_penalty   = 3;
    complete_model       = false;
    enable_intervals     = true;
    unsupported_features = [StdExtZbkb];

    resource PipeA {
        units = 1;
    }
    resource PipeB {
        units = 1;
    }
    resource LSU {
        units  = 1;
        buffer = 4;
    }

    write W_ALU;
    write W_LOAD;
    write W_MULDIV;
    read  R_ALU;

    write_seq W_MULDIV_SEQ = [W_ALU, W_ALU] {
        repeat = 2;
    }
    alias W_MULDIV -> W_MULDIV_SEQ;

    bind W_ALU {
        resources = [PipeA];
        latency   = 1;
    }
    bind W_LOAD {
        resources = [LSU];
        latency   = 3;
        release   = [3];
    }

    advance R_ALU {
        cycles = 1;
        writes = [W_ALU];
    }

    map [ADD, SUB, XOR] {
        0 = W_ALU;
        1 = read_default;
        2 = read_default;
    }
    map [LD] {
        0 = W_LOAD;
        1 = read_default;
    }
    map [regex("MUL.*")] {
        0 = W_ALU;
        1 = read_default;
        2 = read_default;
    }
    map [AND, regex("DIV.*")] {
        0 = W_ALU;
        1 = read_default;
    }

    variant W_ALU {
        case all_of(opcode(ALUInsts), same_reg(1, 2)): [W_ALU];
        default: [W_ALU];
    }

    read_variant R_ALU {
        case all_of(opcode(Logical), IsZeroReg(1)): [R_ALU];
        default: [R_ALU];
    }

    reg_file GPRFile {
        num_phys             = 180;
        classes              = [GPR, GPRNoX0];
        costs                = [1, 1];
        allow_move_elim      = [true, true];
        max_move_elim_per_cy = 4;
        allow_zero_elim_only = false;
    }

    retire_unit {
        buffer        = 320;
        max_per_cycle = 6;
    }
    load_queue {
        resource = LSU;
    }
    store_queue {
        resource = LSU;
    }

    itineraries : packetizer_namespace = "SSDL" {
        func_units = [FU_ALU];
        bypasses   = [no_bypass];

        itin IIC_iALU {
            stages = [stage { cycles = 1; units = [FU_ALU]; }];
            cycles = [1, 1];
        }
    }

    map_itin [IIC_iALU] -> [W_ALU, read_default];
}

machine alias ssdl-sifive-7-alias = ssdl-sifive-7;

machine both ssdl-itin-rv64 {
    features = [FeatureSSDL64Bit];
}

itineraries : packetizer_namespace = "SSDLTop" {
    sched_model = ssdl-itin-rv64;
    func_units  = [FU_TOP];
    bypasses    = [no_bypass_top];

    itin IIC_iTop {
        stages = [
            stage { cycles = 1; units = [FU_TOP]; },
            stage { cycles = 2; units = [FU_TOP]; timeinc = 1; kind = reserved; },
        ];
        cycles   = [1, 3];
        bypasses = [no_bypass_top];
        uops     = 2;
    }
}
