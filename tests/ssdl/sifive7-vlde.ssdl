# Real SiFive7 sub-family: the eight WriteVLDE records of VLEN512.
# The upstream model mints these from LMULSchedWrites<"WriteVLDE"> and
# LMULWriteRes<"WriteVLDE", []> (RISCVSchedSiFive7.td:329, :836).
# WorstCase is folded into the member list for now; v1.2 will spell it as
# worst(LMUL) instead of a pseudo-member.
dimension LMUL = [MF8, MF4, MF2, M1, M2, M4, M8, WorstCase];

machine vlde {
    resource VLEN512SiFive7VCQ : units = 1;
    resource VLEN512SiFive7VL  : units = 1;

    write WriteVLDE[LMUL];

    bind WriteVLDE[LMUL in [MF8, MF4, MF2]] -> [VLEN512SiFive7VCQ, VLEN512SiFive7VL], latency = 4, uops = 1, release = [1, 2], acquire = [0, 1];
    bind WriteVLDE[LMUL in [M1]]              -> [VLEN512SiFive7VCQ, VLEN512SiFive7VL], latency = 4, uops = 1, release = [1, 3], acquire = [0, 1];
    bind WriteVLDE[LMUL in [M2]]              -> [VLEN512SiFive7VCQ, VLEN512SiFive7VL], latency = 4, uops = 1, release = [1, 5], acquire = [0, 1];
    bind WriteVLDE[LMUL in [M4]]              -> [VLEN512SiFive7VCQ, VLEN512SiFive7VL], latency = 4, uops = 1, release = [1, 9], acquire = [0, 1];
    bind WriteVLDE[LMUL in [M8, WorstCase]]   -> [VLEN512SiFive7VCQ, VLEN512SiFive7VL], latency = 4, uops = 1, release = [1, 17], acquire = [0, 1];
}
