# Dimension use sites: one declaration per axis, subsets at the use.
set LMUL = [MF8, MF4, MF2, M1, M2, M4, M8] : kind = dimension, name_format = "_{value}", units = [1, 2, 4, 8, 16, 32, 64];
set LMUL_MF4_M4 = [MF4, MF2, M1, M2, M4] : kind = dimension, name_format = "_{value}", units = [2, 4, 8, 16, 32];
set SEW = [8, 16, 32, 64] : kind = dimension, name_format = "_E{value}", units = [8, 16, 32, 64];
set SEW_Pred = [16, 32, 64] : kind = dimension, name_format = "_E{value}_Pred", units = [16, 32, 64];

feature HasF : kind = plain, mattr = "has-f", field = "HasF", value = "true";

machine dims {
    role = both;
    resource P : units = 1;

    write W[LMUL in [MF4, MF2, M1, M2, M4], SEW in [64]];
    write W[LMUL, SEW_Pred];
    bind W[LMUL in [MF4, MF2, M1, M2, M4], SEW in [64]] -> [P], latency = 4, release = [1, LMUL // 4];

    write W[worst(LMUL_MF4_M4), SEW in [64]];
    bind W[worst(LMUL_MF4_M4), SEW in [64]] -> [P], latency = 4, release = [1, LMUL_MF4_M4 // 4];

    variant W[LMUL in [MF4, MF2, M1, M2, M4], SEW in [64]] {
        case feature(HasF): [W[LMUL, SEW_Pred]];
        default: [W[LMUL, SEW]];
    }
}
