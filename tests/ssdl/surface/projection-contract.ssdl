# v2 twin of tests/ssdl/projection-contract.ssdl.

set relation DivFactor = [(8, 1), (16, 15), (32, 28), (64, 57)];
extern fn cycles(lmul: INT, sew: INT) -> INT from "cycles";

machine family fam(sew: INT) {
    resource P {
        units = 1;
    }
    write W;
    bind W {
        resources = [P];
        latency   = DivFactor(sew);
        release   = [1, cycles(1, sew)];
    }
}

machine instance s8 : fam(8) { }
machine instance s16 : fam(16) { }
