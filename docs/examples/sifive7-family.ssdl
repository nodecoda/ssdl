        case feature(TuneHasSingleElementVecFP64): [WriteVFRecpV[LMUL, SEW_div_3]];
        default: [WriteVFRecpV[LMUL, SEW_div_2]];
    }
    variant WriteVFSgnjF[LMUL in [M1, M2, M4, M8], SEW_div in [64]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFSgnjF[LMUL, SEW_div_3]];
        default: [WriteVFSgnjF[LMUL, SEW_div_2]];
    }
    variant WriteVFSgnjV[LMUL in [M1, M2, M4, M8], SEW_div in [64]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFSgnjV[LMUL, SEW_div_3]];
        default: [WriteVFSgnjV[LMUL, SEW_div_2]];
    }
    variant WriteVFWCvtFToFV[LMUL in [MF2, M1, M2, M4], SEW_div in [32]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFWCvtFToFV[LMUL, SEW_div_3]];
        default: [WriteVFWCvtFToFV[LMUL, SEW_div_2]];
    }
    variant WriteVFWCvtIToFV[LMUL in [MF2, M1, M2, M4], SEW_div in [32]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFWCvtIToFV[LMUL, SEW_div_3]];
        default: [WriteVFWCvtIToFV[LMUL, SEW_div_2]];
    }
    variant WriteVLDS16[LMUL in [MF4, MF2, M1, M2, M4, M8]] {
        case all_of(feature(TuneOptimizedZeroStrideLoad), reg_is(3, X0)): [WriteVLDS16[LMUL_Pred]];
        default: [WriteVLDS16[LMUL_NoPred]];
    }
    variant WriteVLDS16_WorstCase {
        case all_of(feature(TuneOptimizedZeroStrideLoad), reg_is(3, X0)): [WriteVLDS16_M8_Pred];
        default: [WriteVLDS16_M8_NoPred];
    }
    variant WriteVLDS32[LMUL in [MF2, M1, M2, M4, M8]] {
        case all_of(feature(TuneOptimizedZeroStrideLoad), reg_is(3, X0)): [WriteVLDS32[LMUL_Pred]];
        default: [WriteVLDS32[LMUL_NoPred]];
