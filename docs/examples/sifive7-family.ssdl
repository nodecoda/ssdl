# Generated from SiFive7VLEN512Model by tools/ssdl/family_mine.py --emit.
# Formula catalogue: data/riscv-sched-formulas.json (each entry cites TableGen).

feature Feature64Bit : kind = plain, mattr = "64bit", field = "IsRV64", value = "true";
feature TuneOptimizedZeroStrideLoad : kind = plain, mattr = "optimized-zero-stride-load", field = "HasOptimizedZeroStrideLoad", value = "true";
feature TuneHasSingleElementVecFP64 : kind = plain, mattr = "single-element-vec-fp64", field = "HasSingleElementVectorFP64", value = "true";
feature TuneSiFive7 : kind = plain, mattr = "sifive7", field = "RISCVProcFamily", value = "SiFive7", desc = "SiFive 7-Series processors";
feature TuneNoDefaultUnroll : kind = tune, field = "EnableDefaultUnroll", value = "false", positive_directive = "no-default-unroll", negative_directive = "enable-default-unroll", desc = "Disable default unroll preference";
feature TuneShortForwardBranchIALU : kind = tune, field = "HasShortForwardBranchIALU", value = "true", positive_directive = "short-forward-branch-ialu", negative_directive = "no-short-forward-branch-ialu", desc = "Enable short forward branch optimization for RVI base instructions";
feature TunePostRAScheduler : kind = tune, field = "UsePostRAScheduler", value = "true", positive_directive = "use-postra-scheduler", negative_directive = "no-use-postra-scheduler", desc = "Schedule again after register allocation";

predicate Pred_0 = not(feature(Feature64Bit));
predicate Pred_1 = all_of(feature(TuneOptimizedZeroStrideLoad), reg_is(3, X0));
predicate Pred_2 = feature(TuneHasSingleElementVecFP64);

