        default: [WriteVLDS64_M8_NoPred];
    }
    variant WriteVLDS8[LMUL] {
        case all_of(feature(TuneOptimizedZeroStrideLoad), reg_is(3, X0)): [WriteVLDS8[LMUL_Pred]];
        default: [WriteVLDS8[LMUL_NoPred]];
    }
    variant WriteVLDS8_WorstCase {
        case all_of(feature(TuneOptimizedZeroStrideLoad), reg_is(3, X0)): [WriteVLDS8_M8_Pred];
        default: [WriteVLDS8_M8_NoPred];
    }
    map [COPY] -> [WriteIALU];
}

machine sifive_7_series : siFive7(512) {
    tune_features = [TuneSiFive7, TuneNoDefaultUnroll, TuneShortForwardBranchIALU, TunePostRAScheduler];
}
