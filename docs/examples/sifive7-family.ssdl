        default: [WriteVFMulV[LMUL, SEW_div_2]];
    }
    variant WriteVFNCvtFToFV[LMUL in [MF2, M1, M2, M4], SEW_div in [32]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFNCvtFToFV[LMUL, SEW_div_3]];
        default: [WriteVFNCvtFToFV[LMUL, SEW_div_2]];
    }
    variant WriteVFNCvtIToFV[LMUL in [MF2, M1, M2, M4], SEW_div in [32]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFNCvtIToFV[LMUL, SEW_div_3]];
        default: [WriteVFNCvtIToFV[LMUL, SEW_div_2]];
