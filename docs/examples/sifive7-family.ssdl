    advance ReadXPERM : cycles = 0 : unsupported = true;
    read ReadZIP;
    advance ReadZIP : cycles = 0 : unsupported = true;

    variant WriteIDiv {
        case not(feature(Feature64Bit)): [SiFive7RV32IDivRemSchedWriteRes];
        default: [SiFive7RV64IDivRemSchedWriteRes];
    }
    variant WriteIRem {
        case not(feature(Feature64Bit)): [SiFive7RV32IDivRemSchedWriteRes];
        default: [SiFive7RV64IDivRemSchedWriteRes];
    }
    variant WriteVFALUF[LMUL in [M1, M2, M4, M8], SEW_div in [64]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFALUF[LMUL, SEW_div_3]];
        default: [WriteVFALUF[LMUL, SEW_div_2]];
    }
    variant WriteVFALUV[LMUL in [M1, M2, M4, M8], SEW_div in [64]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFALUV[LMUL, SEW_div_3]];
        default: [WriteVFALUV[LMUL, SEW_div_2]];
    }
    variant WriteVFCvtIToFV[LMUL in [M1, M2, M4, M8], SEW_div in [64]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFCvtIToFV[LMUL, SEW_div_3]];
        default: [WriteVFCvtIToFV[LMUL, SEW_div_2]];
    }
    variant WriteVFMinMaxF[LMUL in [M1, M2, M4, M8], SEW_div in [64]] {
        case feature(TuneHasSingleElementVecFP64): [WriteVFMinMaxF[LMUL, SEW_div_3]];
        default: [WriteVFMinMaxF[LMUL, SEW_div_2]];
    }
